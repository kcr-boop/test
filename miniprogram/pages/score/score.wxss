.wrap { padding: 24rpx; display: flex; flex-direction: column; gap: 24rpx; }
.row { display: flex; flex-wrap: wrap; gap: 8rpx; background: var(--paper-white); border: 1rpx solid var(--line); border-radius: 32rpx; padding: 20rpx; }
.explain { background: var(--ink); color: var(--paper-white); border-radius: 32rpx; padding: 28rpx 32rpx; font-size: 34rpx; font-weight: 700; }
